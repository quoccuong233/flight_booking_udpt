# Optional overrides; docker-compose.yml already has development defaults.
POSTGRES_PASSWORD=postgres
REPLICATOR_PASSWORD=replicator
GRAFANA_PASSWORD=admin
# Must also be changed in kong/kong.yml (consumers.jwt_secrets.secret).
JWT_SECRET=dev-only-change-me-flight-booking-secret
# 0 to 1: share of calls to the simulated payment gateway that fail.
GATEWAY_FAIL_RATE=0
# VNPay sandbox terminal (from the email VNPay sends after registration).
# Leave either empty to use the simulated gateway instead.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# Where VNPay sends the browser back; must be the address you open the site at.
VNPAY_RETURN_URL=http://localhost:8000/payment/vnpay-return
# Leave MAIL_RELAY_HOST empty to skip sending email.
# Gmail: MAIL_RELAY_HOST=smtp.gmail.com, MAIL_RELAY_USER=your Gmail address,
# MAIL_RELAY_PASS=16-letter App Password with no spaces.
MAIL_RELAY_HOST=
MAIL_RELAY_PORT=587
MAIL_RELAY_USER=
MAIL_RELAY_PASS=
